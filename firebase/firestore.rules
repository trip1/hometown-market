rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(id) { return signedIn() && request.auth.uid == id; }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if owner(userId) && request.resource.data.uid == userId;
      allow delete: if false;
    }
    match /listings/{listingId} {
      allow read: if resource.data.status == 'active' || owner(resource.data.ownerId);
      allow create: if false; // Cloud Function validates writes.
      allow update, delete: if owner(resource.data.ownerId);
      match /comments/{commentId} {
        allow read: if get(/databases/$(database)/documents/listings/$(listingId)).data.status == 'active';
        allow write: if false; // Cloud Function validates writes.
      }
    }
  }
}
